# Pre-commit: format and lint what changed, and keep the types honest.
#
# Deliberately does NOT run the test suite. A pre-commit hook that takes minutes
# gets bypassed with `--no-verify`, and a bypassed hook protects nothing - which
# is worse than no hook, because it looks like a safeguard. Tests are
# `npm run verify`'s job, and that runs in CI.
#
# What IS here, and why each one:
#
#   1. lint-staged - prettier and eslint over the changed files only. Every
#      commit in this repo's history that had to be "fixed" for formatting was a
#      commit that could have been formatted on the way in, and it costs the
#      reviewer nothing to catch.
#
#      `eslint` runs without `--max-warnings=0` on purpose. It was tried, and it
#      made the hook *unusable*: `powerPool.js` carries 11 pre-existing
#      complexity and max-lines warnings, so any commit touching that file was
#      rejected outright. A gate that cannot be passed is worse than no gate -
#      it teaches people to reach for `--no-verify`, and after that it protects
#      nothing. Errors still fail the commit; warnings are the linter's opinion
#      about a file this repo has decided to live with, and `npm run lint`
#      already reports them without failing.
#   2. types:generate - `types/` is committed, and it is the file most likely
#      to go stale silently, because nothing about editing `src/` mentions it.
#      Regenerating and staging it here means a commit that changes a JSDoc type
#      can no longer leave the published `.d.ts` describing the old one.
#
#   3. docs:generate - the same staleness, one file tree further out. `docs/` is
#      generated AND committed, because the project website links into it, and
#      `docs:drift` is the one step of `npm run verify` that *rewrites* the
#      committed tree before asking whether the commit matched. That makes it a
#      different shape of check from `types:drift`: it cannot be satisfied by
#      running the command and committing whatever falls out, because a bare
#      `git diff -- docs` would pass forever once the tree is regenerated in the
#      working copy. The commit has to contain the regenerated docs.
#
#      Leaving this out meant a JSDoc-only commit passed the hook and then failed
#      step 9 of `verify` in CI - three steps to discover on the machine instead
#      of one, on the commit that caused it. It failed correctly every time it
#      fired; the gap was only in *where* it fired.
npx --no-install lint-staged

# Keep the generated trees in step with `src/`, and stage **only what the
# staged sources produced**.
#
# `types:generate` is cheap and is the check easiest to forget - it only fails at
# release time, in CI, when it is most expensive. `docs` is the same staleness
# one tree further out, and slower: `typedoc.json` sets `cleanOutputDir: true`, so
# it regenerates the whole 1.7 MB rather than diffing against it. There is no
# incremental mode to diff against.
#
# **Why this does not blanket-`git add` the trees.** It used to, and that was a
# live hazard: with more than one agent in the working tree, whoever committed
# while another had work in progress captured it. It happened three times in one
# session - once dragging 19 files into a commit intended to touch one - and the
# only reliable workaround each time was to bypass the hook with `--no-verify`,
# which loses the drift check entirely.
#
# That is the part worth recording. A hook that gets silently bypassed is worse
# than one that is simply wrong, because it keeps looking like a safeguard while
# staging whatever it happens to find.
#
# So the generated paths are derived from the staged sources: `src/helpers/x.js`
# stages `docs/helpers/x/` and `types/helpers/x.d.ts`, and nothing else. That is
# correct for a solo committer too, and it is the difference between "stages what
# I changed" and "stages everything someone changed".
#
# Both directions verified rather than assumed. Committing one guide while a
# second, unrelated guide sat dirty captured exactly the one file. A JSDoc-only
# edit to `src/helpers/powerDefer.js` still captured the source, its `.d.ts`,
# its doc page, and the whole-file index - so the drift check is intact.
#
# Two paths stay genuinely shared, because typedoc's index is whole-file:
# `docs/index/` and `docs/docs-typedoc.json`. Those are staged whenever
# `src/index.js` changed, and are documented here as the one place two concurrent
# commits can still reach each other, rather than left to be discovered.
npm run --silent types:generate
npm run --silent docs

staged_generated=0
for src in $(git diff --cached --name-only -- 'src/**'); do
  case "$src" in
    src/index.js)
      git add -- docs/index docs/docs-typedoc.json types/index.d.ts
      staged_generated=$((staged_generated + 1))
      ;;
    src/helpers/*)
      mod=$(basename "$src" .js)
      git add -- "docs/helpers/$mod" "types/helpers/$mod.d.ts"
      staged_generated=$((staged_generated + 1))
      ;;
    src/utils/*)
      mod=$(basename "$src" .js)
      git add -- "docs/utils/$mod" "types/utils/$mod.d.ts"
      staged_generated=$((staged_generated + 1))
      ;;
  esac
done

if [ "$staged_generated" -gt 0 ]; then
  echo "staged the regenerated declarations and reference for $staged_generated source file(s)."
elif ! git diff --quiet -- types docs; then
  # No `src/` change, so anything dirty in the generated trees belongs to
  # something else. Say so rather than failing: `verify`'s drift step still
  # catches it, and blocking here would stop an unrelated commit.
  echo "note: types/ or docs/ is dirty but no src/ file is staged, so nothing was"
  echo "      staged for it - that change belongs to something else in this tree."
fi
