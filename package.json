  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{js,cjs,mjs}\" \"test/**/*.js\" \"bench/**/*.js\" \"scripts/**/*.{js,cjs,mjs}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,cjs,mjs}\" \"test/**/*.js\" \"bench/**/*.js\" \"scripts/**/*.{js,cjs,mjs}\"",
    "format": "prettier --write \"src/**/*.{js,cjs,mjs}\" \"test/**/*.js\" \"bench/**/*.js\" \"scripts/**/*.{js,cjs,mjs}\" \"*.md\"",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "audit:exports": "node scripts/static-audit-exports.cjs",
    "docs": "typedoc",
    "bench": "node bench/run.js",
    "bench:pool": "node bench/run.js pool",
    "bench:cache": "node bench/run.js cache",
    "types:generate": "tsc --project tsconfig.json --emitDeclarationOnly --declaration --allowJs --outDir types --declarationMap false",
    "build:full": "npm run lint:fix && npm run format && npm run types:generate && npm run bench && npm run build && npm run test && npm run docs",
    "prepublishOnly": "npm run lint && npm run test && npm run test:types && npm run build && npm run types:generate",
    "test:types": "tsc --noEmit --project tsconfig.types.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
