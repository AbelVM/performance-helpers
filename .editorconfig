# EditorConfig: https://editorconfig.org
#
# These values mirror .prettierrc deliberately, and they must keep matching it.
# The two tools disagree when they do, and the symptom is a file that Prettier
# rewrites on every `npm run format` no matter what the editor did - which is
# how formatting churn gets into commits in the first place.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Prettier's `proseWrap: "preserve"` (the default) leaves prose alone, and
# trailing double-space is a hard line break in Markdown, so trimming it here
# would silently change rendered output.
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
